# Base URL where this app is reachable (used for OAuth callback URLs)
# Replit example: https://your-app.repl.co
# DO example: https://yhcway.ondigitalocean.app
APP_BASE_URL=http://localhost:5000

# DigitalOcean Spaces (S3-compatible object storage)
# Endpoint URL for your Space (e.g., https://nyc3.digitaloceanspaces.com)
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# Region of your Space (e.g., nyc3, sfo3, ams3)
DO_SPACES_REGION=nyc3
# Name of your Space (bucket)
DO_SPACES_BUCKET=your-space-name
# Spaces access key (generate in DO control panel → API → Spaces Keys)
DO_SPACES_KEY=your-access-key
# Spaces secret key
DO_SPACES_SECRET=your-secret-key
